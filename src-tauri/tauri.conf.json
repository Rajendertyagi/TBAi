{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TBAi",
  "version": "0.1.0",
  "identifier": "com.tbai.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "./frontend-placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TBAi",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "url": "http://localhost:3000",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../web/dist/*": "web/"
    },
    "externalBin": ["binaries/tbai-server"]
  }
}
