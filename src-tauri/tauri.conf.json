{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TBAi",
  "version": "0.1.0",
  "identifier": "com.tbai.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "app://localhost",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "appDirectoriesOverride": {
      "config": "./data"
    },
    "windows": [
      {
        "label": "main",
        "title": "TBAi",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* http://localhost:*;"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/web/*": "web/"
    },
    "externalBin": ["binaries/tbai-server"]
  }
}
