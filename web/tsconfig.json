{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // No `baseUrl`. Deprecated in TypeScript 6.0, removed in 7.0. Without it,
    // `paths` entries resolve relative to this file - which is what the single
    // entry below already assumed (`baseUrl: "."` meant this same directory).
    // Vite is unaffected: `vite.config.ts` declares its own `@` -> ./src alias
    // and never reads these paths.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
