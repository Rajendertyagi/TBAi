{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",

  // Import organization stays OFF. `organizeImports` is an ASSIST action, not a
  // lint rule, and `biome check` does not apply assists unless they are
  // explicitly enabled - so this block is preserved verbatim from the previous
  // configuration as a recorded decision, not as dead weight. Turning it on
  // would reorder imports in 800+ files; that is a reviewable change of its own,
  // never a side effect of enabling a lint gate.
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      // Recommended rules are the BASELINE. They are the defect classes Biome's
      // authors judged safe to enable everywhere: unused bindings, undeclared
      // variables, broken React hooks, empty regex classes, unsafe optional
      // chaining. Experimental (`nursery`) and stylistic groups are NOT enabled -
      // they churn without catching defects.
      //
      // Every rule below in `off` is a rule that CANNOT work correctly in this
      // repository, with the reason recorded. A rule is only listed here if it
      // produces false positives or fights a deliberate convention; "we do not
      // like it" is not a reason.
      "preset": "recommended",

      "correctness": {
        // These four cannot resolve this repo's module graph. `@/*`, `@web/*`
        // and `@backend/*` are tsconfig `paths` aliases, and imports carry
        // explicit `.ts`/`.tsx` extensions; Biome resolves neither, so it would
        // report every aliased and every extension-carrying import as broken.
        "noUnresolvedImports": "off",
        "noUndeclaredDependencies": "off",
        "useImportExtensions": "off",
        // Framework-agnostic heuristics that misfire on React. Qwik's lexical
        // scope rule flags React hooks, and the Solid rule flags destructured
        // props in React components.
        "useQwikValidLexicalScope": "off",
        "noSolidDestructuredProps": "off",
        // Node globals are legitimate on the backend (Bun server, scripts,
        // build tooling). `noNodejsModules` and `noProcessGlobal` are option-
        // driven rules for codebases that forbid them; this one does not.
        "noNodejsModules": "off",
        "noProcessGlobal": "off"
      },

      "a11y": {
        // `<div role="group">`, `<div role="listbox">` and `<div role="radiogroup">`
        // are what the WAI-ARIA Authoring Practices prescribe for these widgets.
        // The rule wants them replaced by `<fieldset>`/`<ul>`, which are DOCUMENT
        // semantics: a fieldset brings form participation and a required
        // `<legend>`, and a `<ul>` brings list semantics to what is really a chip
        // menu or a toolbar. Following the rule here would make the accessibility
        // tree less correct, not more.
        //
        // This is a style rule that conflicts with correct ARIA, not a defect
        // class. The genuinely broken cases - `role="list"` on an interactive
        // listbox - were fixed by changing the role, and those fixes stay.
        "useSemanticElements": "off"
      },

      "style": {
        // 610 sites. A non-null assertion is a CLAIM the programmer makes after
        // TypeScript has already proven the value is non-null; it is how you
        // express "I checked, here is the proof" at a boundary. The rule is
        // also redundant with the compiler: `strictNullChecks` is already on and
        // already proves every one of those sites, so the lint adds no signal
        // and its removal is a large, risky refactor with no defect caught.
        "noNonNullAssertion": "off"
      },

      "suspicious": {
        // 161 sites. `noExplicitAny` flags the ANNOTATION, not a defect: an
        // explicit `any` is a deliberate, visible decision to give up a type,
        // and it is already visible in review. What actually catches accidents
        // is IMPLICIT any, which `noImplicitAny` (TypeScript) and
        // `noImplicitAnyLet` (this config, still on) already cover. Suppressing
        // the rule wholesale also would not prevent an `any` - it would only
        // remove the one place a reviewer sees the word and can object.
        "noExplicitAny": "off"
      }
    }
  },

  "formatter": {
    "enabled": true,
    // These four match the code that is already written, so enabling the
    // formatter contributes (almost) no diff on its own. The measured diff is
    // line WIDTH, which is why `lineWidth` is the only value that matters here.
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "auto",
    // Measured against this tree: 80 -> 780 files change, 100 -> 740,
    // 120 -> 772, 140 -> 782. 100 is the smallest mechanical diff available,
    // and it is a conventional, readable width for this codebase.
    "lineWidth": 100
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "files": {
    // Maintained code, the test tree, the tooling scripts, and the
    // configuration files that describe them.
    //
    // `scripts/**` was previously OUTSIDE the scope entirely - the build,
    // profiling, e2e and policy-check scripts were never linted at all.
    "includes": [
      "src/**",
      "web/src/**",
      "tests/**",
      "scripts/**",
      "biome.json",
      "package.json",
      "tests/package.json",
      "web/package.json",
      "tsconfig.json",
      "tests/tsconfig.json",
      "tests/tsconfig.backend.json",
      "tests/tsconfig.web.json",
      "web/tsconfig.json",
      "web/tsconfig.node.json",
      "web/vite.config.ts",
      "web/playwright.config.ts",

      // Generated output and runtime artifacts. These are produced by a command,
      // never edited by hand, and linting them would report on build products.
      "!tests/.artifacts",
      "!dist",
      "!web/dist",
      "!web/dist-profile",
      "!src-tauri/gen",
      "!src-tauri/target",
      "!docs/tool-ui-atlas",
      // Compiled twins a bare `tsc` used to emit beside every source file. The
      // root tsconfig sets `noEmit`, so these must never reappear; if one does,
      // it is a defect to investigate, not a file to format.
      "!src/**/*.js",
      "!scripts/**/*.js"
    ]
  },

  // File-scoped exceptions. Each names one file and one rule, and exists because
  // the rule misreads the construct - never because a fix was inconvenient.
  "overrides": [
    {
      // The assistant message's action row carries `onMouseEnter`/`onMouseLeave`
      // purely to reveal its buttons on pointer hover. Every action inside is a
      // real button and is reachable by keyboard without the hover, so there is
      // no accessibility gap to close; giving the wrapper a role would announce
      // an interactive element that is not one. Scoped to this file because this
      // is the only such hover-only wrapper.
      "includes": ["web/src/components/ChatWindow.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}
