{
  // Typecheck project for BACKEND tests in the canonical `tests/` tree.
  //
  // Why this exists: the tests moved out of the application source trees, and the
  // root tsconfig includes only `src` and `scripts` - so the tests already in
  // `tests/` were never typechecked, and the 63 backend tests that were
  // colocated inside `src/` silently lost that coverage when they moved.
  //
  // Why a separate project rather than adding `tests` to the root tsconfig: one
  // TypeScript program cannot map `@/*` to both the backend `src/` and the web
  // `src/`, because both really do contain the same module paths
  // (`src/lib/logger.ts` AND `web/src/lib/logger.ts`). Each test project
  // therefore inherits the resolution rules of the code it exercises, which is
  // the only way a test is checked under the same rules as its subject.
  //
  // `baseUrl` is deliberately NOT overridden. `extends` resolves the base
  // config's relative paths against the BASE config's own directory, so the
  // inherited `baseUrl` is already the repository root - exactly where the root
  // tsconfig resolves `@/*`. Overriding it was a real bug: it silently repointed
  // web imports at the backend tree and produced "has no exported member"
  // errors against perfectly good source.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The suites import with explicit `.ts` extensions (the convention
    // `web/tsconfig.json` already enables); without this the backend project
    // rejects them wholesale.
    "allowImportingTsExtensions": true,
    // NOT strict, deliberately, and the difference is the point.
    //
    // The root config enables `strict` for SHIPPED code (`src` + `scripts`).
    // This project typechecks TESTS, which reach into SQLite rows and drive
    // partial fixtures where a nullable read is normal and harmless. Making
    // them strict is a separate, larger piece of work: it is 36 errors across
    // the existing backend suites, none of which indicate a defect in the code
    // under test.
    //
    // So the boundary is drawn where it protects something: shipped code is
    // strict, tests keep the previous rules until they are migrated
    // deliberately. Turning strict on here would mean editing ~20 existing
    // test files to satisfy a rule they were never written under.
    "strict": false,
    // `strict: false` alone does NOT undo the individual strictNullChecks the
    // root now sets - TypeScript treats each family member independently, so the
    // root's explicit `strictNullChecks: true` would survive and the project
    // would stay partly strict. Both are cleared here deliberately.
    "strictNullChecks": false,
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./src/*"],
      "@backend/*": ["./src/*"],
      "@web/*": ["./web/src/*"]
    }
  },
  "include": [
    "setup.ts",
    "test-sandbox.ts",
    "fixtures/**/*.ts",
    "harness/**/*.ts",
    // Only the root-anchored resolver. `helpers/dom/**` and `helpers/web/**` are
    // DOM/React harness code that reaches into `web/src` and the assistant-ui
    // internals; including them here would drag web sources into a program where
    // `@/*` means the BACKEND tree, and every one of their `@/...` imports would
    // fail to resolve. They are checked by tsconfig.web.json instead.
    "helpers/repo-root.ts",
    "integration/**/*.ts",
    "tests/unit/mcp/mcp-connection.test.ts",
    "integration/**/*.tsx",
    "unit/**/*.ts",
    "unit/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "unit/web/**",
    // Tests that exercise WEB source are checked by tests/tsconfig.web.json,
    // never here. `@/*` means `src/*` in this project, so a suite importing
    // `@web/*` would pull web sources into a program where their own `@/...`
    // imports resolve to the backend tree and every one of them fails to
    // resolve. `exclude` alone is not enough - it filters the include globs
    // but an import still pulls the file in - so tsconfig.web.json adds the
    // same set back. Both lists are generated by scanning for `@web/` imports;
    // keep them in step.
    "integration/opencode/opencode-context-meter-runtime.test.ts",
    "integration/opencode/opencode-native-compaction-conformance.test.ts",
    "unit/core/denial-label.test.ts",
    "unit/core/foundation.test.ts",
    "unit/core/patch-to-diffs.test.ts",
    "unit/core/sidebar-sections.test.ts",
    "unit/scheduler/scheduler-view.test.ts",
    "unit/tools/terminal-lines.test.ts",
    "unit/tools/toolkit.test.ts"
  ]
}