{
  // Typecheck project for WEB tests in the canonical `tests/` tree.
  //
  // The mirror image of `tsconfig.backend.json`. These suites drive React,
  // happy-dom and Playwright, so they need the DOM lib and the web project's
  // strictness - options the root tsconfig deliberately does not have.
  //
  // They were previously typechecked only because they were colocated inside
  // `web/src`, which `web/tsconfig.json` includes. Moving them to `tests/` drops
  // that coverage unless a project with the SAME resolution rules picks them up,
  // which is why this extends the web config rather than the root one.
  //
  // `baseUrl` is NOT overridden: `extends` resolves the base config's relative
  // paths against the base config's own directory, so the inherited `baseUrl`
  // is `web/` - meaning web sources resolve exactly as they do under
  // `bun run typecheck` in `web/`. The `paths` below are therefore written
  // relative to `web/`, not to the repository root.
  "extends": "../web/tsconfig.json",
  "compilerOptions": {
    // Set EXPLICITLY rather than inherited. `extends` is supposed to re-resolve a
    // base config's relative `baseUrl` against the base config's own directory,
    // but relying on that left `@/components/ui/button` unresolvable for every
    // web source file this project pulled in - 656 errors, none of them real.
    // `../web` is unambiguous: paths below are written relative to the web root,
    // exactly as `web/tsconfig.json` resolves them.
    "baseUrl": "../web",
    // NOT strict, deliberately - see the same note in tsconfig.backend.json.
    // Shipped code (`web/src` and the backend `src`) is strict; the test tree
    // keeps its previous rules until it is migrated on purpose.
    "strict": false,
    // `strict: false` alone does NOT undo the root's explicit
    // `strictNullChecks: true` - each family member is independent. Both are
    // cleared, or this project stays partly strict.
    "strictNullChecks": false,
    "noImplicitAny": false,
    // bun:test's `describe`/`it`/`expect` must be in scope; web/tsconfig.json sets
    // no `types`, so without this the DOM suite reports every test global as an
    // unknown name (TS7031 x165).
    // "bun" supplies bun:test's globals (describe/it/expect); "node" must stay
    // alongside it because naming `types` DISABLES auto-inclusion of every other
    // @types package, and web source uses Node globals (process, Buffer,
    // NodeJS.Timeout). Listing only "bun" cascaded into ~250 bogus errors.
    "types": ["bun", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["./src/*"],
      // Test-only helpers that used to live at `web/src/testing/`. They have
      // zero production importers, so the migration moved them into the canonical
      // test tree; `@web/testing/*` keeps the old specifier resolving rather than
      // leaving 21 test files pointing at a directory that no longer exists.
      //
      // These paths are relative to `baseUrl` (web/), NOT to this file, so
      // reaching tests/helpers means going up to the repo root and back down.
      "@web/testing/*": ["../tests/helpers/web/*"],
      "@backend/*": ["../src/*"]
    }
  },
  "include": [
  // Tests that exercise WEB source are checked by tests/tsconfig.web.json,
  // never here. `@/*` means `src/*` in this project, so a suite importing
  // `@web/*` would pull web sources into a program where their own `@/...`
  // imports resolve to the backend tree and every one of them fails to
  // resolve. `exclude` alone is not enough - it filters the include globs
  // but an import still pulls the file in - so tsconfig.web.json adds the
  // same set back. Both lists are generated by scanning for `@web/` imports;
  // keep them in step.,
    "integration/opencode/opencode-context-meter-runtime.test.ts",
    "integration/opencode/opencode-native-compaction-conformance.test.ts",
    "unit/core/denial-label.test.ts",
    "unit/core/foundation.test.ts",
    "unit/core/patch-to-diffs.test.ts",
    "unit/core/sidebar-sections.test.ts",
    "unit/scheduler/scheduler-view.test.ts",
    "unit/tools/terminal-lines.test.ts",
    "unit/tools/toolkit.test.ts",
    "dom/**/*.ts",
    "dom/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "spikes/**/*.ts",
    "spikes/**/*.tsx",
    "unit/web/**/*.ts",
    "unit/web/**/*.tsx",
    "helpers/**/*.ts",
    "helpers/**/*.tsx",
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx",
    "setup/**/*.ts",
    // Ambient declarations that live in the web tree. The web project picks them
    // up because it includes `src`; this project includes only `tests`, so
    // without naming them the Vite `?raw` imports in `web/src/lib/spellcheck.ts`
    // and the untyped `typo-js` dependency report as TS2307 against files that
    // are perfectly well typed in `bun run typecheck`'s web project.
    "../web/src/vite-env.d.ts",
    "../web/src/typo-js.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}