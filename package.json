{
  "name": "tbai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run build:backend && bun run build:web",
    "build:backend": "bun build src/index.ts --compile --outfile dist/tbai-server",
    "build:web": "bun scripts/build-web.ts",
    "build:web:raw": "cd web && bun run build",
    "build:web:profile": "cd web && TBAI_PROFILE_BUILD=1 bun run build",
    "profile:web": "bun run scripts/profile-web.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.backend.json && tsc --noEmit -p tests/tsconfig.web.json && cd web && tsc --noEmit",
    "lint": "biome ci --error-on-warnings --max-diagnostics=none .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "security": "semgrep scan --config auto",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test:locations && bun run build && bun run test && bun run test:dom",
    "verify:full": "bun run verify && bun run security",
    "test": "bun test --isolate ./tests/unit ./tests/integration --path-ignore-patterns \"**/shutdown-lifecycle.test.ts\" --timeout=30000",
    "test:locations": "bun scripts/check-test-location.ts",
    "test:dom": "bun test --isolate --preload ./tests/setup/dom-preload.ts ./tests/dom",
    "test:shutdown": "bun test tests/integration/core/shutdown-lifecycle.test.ts",
    "test:e2e": "bun scripts/run-e2e.ts",
    "gen:icon": "bun run scripts/gen-icon.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "^20.14.5",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "gpt-tokenizer": "4.0.0",
    "react-router": "^8.3.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "3.0.44",
    "@assistant-ui/ai-sdk": "^0.0.12",
    "@assistant-ui/react": "^0.15.26",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@noble/ciphers": "^2.4.0",
    "@opencode/client": "2.0.25",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tanstack/react-virtual": "3.14.14",
    "@tanstack/virtual-core": "3.18.0",
    "ai": "7.0.137",
    "assistant-stream": "^0.3.48",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
